# ============================================================
# SHANTI ENTERPRISES — Frontend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# All variables MUST start with VITE_ to be exposed to React.
# ============================================================

# ─── Backend API URL ─────────────────────────────────────────
# Point this to your running backend server.
# Development default: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# ─── Razorpay Public Key ─────────────────────────────────────
# Your Razorpay Key ID (public — safe to expose in frontend).
# The backend also returns this in the payment response, so
# this variable is used only as a fallback.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
