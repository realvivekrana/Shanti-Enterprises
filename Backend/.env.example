# Copy this file to ".env" in the Backend folder and fill in real values.
# ".env" is already in .gitignore, so it will never be committed.

# ==============================
# DATABASE
# ==============================
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shanti-enterprises

# Sirf tab true karo agar tumhara ISP/network MongoDB Atlas ka
# SRV DNS record resolve nahi kar pa raha (rare case).
USE_GOOGLE_DNS=false

# ==============================
# SERVER
# ==============================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================
# AUTH
# ==============================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Admin registration ke liye secret code (registerAdmin endpoint isse protect hota hai)
ADMIN_REGISTER_CODE=replace_with_a_secret_code

# Sirf "npm run createAdmin" jaisa seed script chalane ke liye (scripts/createAdmin.js)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ==============================
# CLOUDINARY (product images)
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# RAZORPAY (payments)
# ==============================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==============================
# EMAIL (Gmail SMTP via nodemailer)
# ==============================
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ==============================
# SHIPROCKET (shipping)
# ==============================
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_PACKAGE_LENGTH_CM=10
SHIPROCKET_PACKAGE_BREADTH_CM=10
SHIPROCKET_PACKAGE_HEIGHT_CM=10

# ==============================
# TWILIO (SMS / WhatsApp) - optional
# ==============================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# ==============================
# INVOICE — SELLER (business) DETAILS
# ==============================
SHANTI_ENTERPRISES_NAME=Shanti Enterprises
SHANTI_ENTERPRISES_ADDRESS=
SHANTI_ENTERPRISES_CITY=
SHANTI_ENTERPRISES_STATE=
SHANTI_ENTERPRISES_PINCODE=
SHANTI_ENTERPRISES_GSTIN=
SHANTI_ENTERPRISES_PHONE=
SHANTI_ENTERPRISES_EMAIL=